    "# scan_path_and_antenna_motion.py\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "# ----- User inputs (only change these) -----\n",
    "nx, ny, nz = 60, 60, 60\n",
    "x_bounds = (0.00, 0.30)   # meters (vertical axis extent)\n",
    "y_bounds = (0.00, 0.30)   # meters (horizontal axis extent)\n",
    "z_bounds = (0.00, 0.05)   # meters (downrange view thickness for the plot)\n",
    "\n",
    "# ----- Fixed scan settings -----\n",
    "N = 5                     # 5x5 grid\n",
    "STEP_M = 0.040            # 40 mm step\n",
    "START_XY = (0.0, 0.0)     # origin of scan (x=vertical, y=horizontal)\n",
    "MAT_FILE = \"AntennaLocations.mat\"\n",
    "\n",
    "# Optional: SciPy for .mat\n",
    "try:\n",
    "    from scipy.io import loadmat\n",
    "    SCIPY_OK = True\n",
    "except Exception:\n",
    "    SCIPY_OK = False\n",
    "\n",
    "\n",
    "# ------- Helpers -------\n",
    "def load_antennas(mat_file=MAT_FILE):\n",
    "    \"\"\"\n",
    "    Load antenna locations (created earlier).\n",
    "      Expects: TX_x (20,), TX_y (20,), RX_x (20,), RX_y (20,)\n",
    "    Returns line endpoints for TX and RX (2x3 each), and the raw vectors.\n",
    "    \"\"\"\n",
    "    global TX_x, TX_y, RX_x, RX_y  # allow fallback if already in session\n",
    "    if all(k in globals() for k in (\"TX_x\", \"TX_y\", \"RX_x\", \"RX_y\")):\n",
    "        TXx, TXy, RXx, RXy = map(np.asarray, (TX_x, TX_y, RX_x, RX_y))\n",
    "    else:\n",
    "        if not SCIPY_OK:\n",
    "            raise RuntimeError(\"scipy is required to load AntennaLocations.mat (pip install scipy).\")\n",
    "        if not Path(mat_file).exists():\n",
    "            raise FileNotFoundError(f\"'{mat_file}' not found. Put it next to this script or adjust MAT_FILE.\")\n",
    "        S = loadmat(mat_file)\n",
    "        TXx = np.ravel(S[\"TX_x\"]).astype(float)\n",
    "        TXy = np.ravel(S[\"TX_y\"]).astype(float)\n",
    "        RXx = np.ravel(S[\"RX_x\"]).astype(float)\n",
    "        RXy = np.ravel(S[\"RX_y\"]).astype(float)\n",
    "\n",
    "    # Build clean line segments (z=0 plane)\n",
    "    TX_line = np.array([[TXx.min(), TXy[0], 0.0],\n",
    "                        [TXx.max(), TXy[0], 0.0]])\n",
    "    RX_line = np.array([[RXx[0], RXy.min(), 0.0],\n",
    "                        [RXx[0], RXy.max(), 0.0]])\n",
    "    return {\"TX_line\": TX_line, \"RX_line\": RX_line, \"TXx\": TXx, \"TXy\": TXy, \"RXx\": RXx, \"RXy\": RXy}\n",
    "\n",
    "\n",
    "def make_snake_positions(N=5, step=0.04, start_xy=(0.0, 0.0)):\n",
    "    \"\"\"\n",
    "    5x5 snake in x (vertical) and y (horizontal).\n",
    "    Order:\n",
    "      row2: 10  9  8  7  6\n",
    "      row1:  1  2  3  4  5\n",
    "      ...\n",
    "      to 25\n",
    "    Returns positions (25x2) and order_map (5x5).\n",
    "    \"\"\"\n",
    "    x0, y0 = start_xy\n",
    "    xs = x0 + np.arange(N) * step\n",
    "    ys = y0 + np.arange(N) * step\n",
    "    order_map = np.zeros((N, N), dtype=int)\n",
    "    positions = []\n",
    "    idx = 1\n",
    "    for r in range(N):\n",
    "        cols = range(N) if (r % 2 == 0) else range(N - 1, -1, -1)\n",
    "        for c in cols:\n",
    "            order_map[r, c] = idx\n",
    "            positions.append([xs[r], ys[c]])\n",
    "            idx += 1\n",
    "    return np.array(positions, float), order_map\n",
    "\n",
    "\n",
    "def translate_line(line2x3, dx, dy):\n",
    "    \"\"\"Translate a 2-point line [ [x1,y1,z1], [x2,y2,z2] ] by (dx,dy).\"\"\"\n",
    "    out = line2x3.copy()\n",
    "    out[:, 0] += dx\n",
    "    out[:, 1] += dy\n",
    "    return out\n",
    "\n",
    "\n",
    "def draw_voxel_bounds(ax, xb, yb, zb, lw=1.2):\n",
    "    \"\"\"Translucent wireframe box for the voxel volume.\"\"\"\n",
    "    x0, x1 = xb; y0, y1 = yb; z0, z1 = zb\n",
    "    edges = [\n",
    "        ([x0, x1], [y0, y0], [z0, z0]), ([x0, x1], [y1, y1], [z0, z0]),\n",
    "        ([x0, x0], [y0, y1], [z0, z0]), ([x1, x1], [y0, y1], [z0, z0]),\n",
    "        ([x0, x1], [y0, y0], [z1, z1]), ([x0, x1], [y1, y1], [z1, z1]),\n",
    "        ([x0, x0], [y0, y1], [z1, z1]), ([x1, x1], [y0, y1], [z1, z1]),\n",
    "        ([x0, x0], [y0, y0], [z0, z1]), ([x0, x0], [y1, y1], [z0, z1]),\n",
    "        ([x1, x1], [y0, y0], [z0, z1]), ([x1, x1], [y1, y1], [z0, z1]),\n",
    "    ]\n",
    "    for X, Y, Z in edges:\n",
    "        # remember: screen X = y, screen Y = x (your preferred view)\n",
    "        ax.plot(Y, X, Z, linewidth=lw, alpha=0.9)\n",
    "\n",
    "\n",
    "def plot_scan_and_motion(nx, ny, nz, x_bounds, y_bounds, z_bounds):\n",
    "    ants = load_antennas()\n",
    "    TX_line0, RX_line0 = ants[\"TX_line\"], ants[\"RX_line\"]\n",
    "\n",
    "    positions, order_map = make_snake_positions(N=N, step=STEP_M, start_xy=START_XY)\n",
    "\n",
    "    fig = plt.figure(figsize=(10, 7))\n",
    "    ax = fig.add_subplot(projection=\"3d\")\n",
    "\n",
    "    # Voxel box\n",
    "    draw_voxel_bounds(ax, x_bounds, y_bounds, z_bounds)\n",
    "\n",
    "    # Plot scan path polyline at z=0 (screen X=y, screen Y=x)\n",
    "    z_plane = np.zeros(len(positions))\n",
    "    ax.plot(positions[:, 1], positions[:, 0], z_plane, linewidth=2, label=\"Scan path\")\n",
    "\n",
    "    # Show antenna arrays at EVERY scan position (light alpha for minimal clutter)\n",
    "    for i, (xv, yv) in enumerate(positions, start=1):\n",
    "        TX_i = translate_line(TX_line0, xv, yv)\n",
    "        RX_i = translate_line(RX_line0, xv, yv)\n",
    "        ax.plot(TX_i[:, 1], TX_i[:, 0], TX_i[:, 2], linewidth=2, alpha=0.25)\n",
    "        ax.plot(RX_i[:, 1], RX_i[:, 0], RX_i[:, 2], linewidth=2, alpha=0.25)\n",
    "\n",
    "    # Highlight a few key steps so you can check geometry quickly\n",
    "    highlight = [1, 5, 10, 15, 20, 25]\n",
    "    for i in highlight:\n",
    "        xv, yv = positions[i - 1]\n",
    "        TX_i = translate_line(TX_line0, xv, yv)\n",
    "        RX_i = translate_line(RX_line0, xv, yv)\n",
    "        ax.plot(TX_i[:, 1], TX_i[:, 0], TX_i[:, 2], linewidth=4, label=f\"TX at {i}\")\n",
    "        ax.plot(RX_i[:, 1], RX_i[:, 0], RX_i[:, 2], linewidth=4, label=f\"RX at {i}\")\n",
    "        ax.text(yv, xv, 0.0, f\"{i}\", fontsize=10, ha=\"center\", va=\"bottom\")\n",
    "\n",
    "    # Axes & view\n",
    "    ax.set_xlabel(\"y (horizontal)\")\n",
    "    ax.set_ylabel(\"x (vertical)\")\n",
    "    ax.set_zlabel(\"z (downrange)\")\n",
    "    ax.set_xlim(y_bounds[0], y_bounds[1])\n",
    "    ax.set_ylim(x_bounds[0], x_bounds[1])\n",
    "    ax.set_zlim(z_bounds[0], z_bounds[1])\n",
    "    ax.set_box_aspect((y_bounds[1]-y_bounds[0], x_bounds[1]-x_bounds[0], z_bounds[1]-z_bounds[0]))\n",
    "    ax.view_init(elev=18, azim=35)\n",
    "    ax.set_title(f\"Scan Path & Antenna Motion — 5×5 Snake (step=40 mm), Voxels {nx}×{ny}×{nz}\")\n",
    "\n",
    "    # --- Movable legend (this is the only change you need) ---\n",
    "    leg = ax.legend(loc=\"upper left\", frameon=True, facecolor=\"white\", edgecolor=\"0.85\")\n",
    "    leg.set_draggable(True)  # click and drag the legend to reposition\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # Quick geometry prints so you can verify backprojection frame-by-frame if needed\n",
    "    def report(k):\n",
    "        xv, yv = positions[k - 1]\n",
    "        TX_i = translate_line(TX_line0, xv, yv)\n",
    "        RX_i = translate_line(RX_line0, xv, yv)\n",
    "        print(f\"[Step {k:02d}] TX line x-range: [{TX_i[:,0].min():.4f}, {TX_i[:,0].max():.4f}]  \"\n",
    "              f\"y={TX_i[0,1]:.4f} | RX line y-range: [{RX_i[:,1].min():.4f}, {RX_i[:,1].max():.4f}]  \"\n",
    "              f\"x={RX_i[0,0]:.4f}\")\n",
    "    for k in highlight:\n",
    "        report(k)\n",
    "\n",
    "    return {\"positions\": positions, \"order_map\": order_map, **ants}\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    _ = plot_scan_and_motion(nx, ny, nz, x_bounds, y_bounds, z_bounds)\n",
    "\n"
   ]
  },
