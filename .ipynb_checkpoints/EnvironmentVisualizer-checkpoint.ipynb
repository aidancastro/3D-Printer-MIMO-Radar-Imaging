    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patheffects as pe\n",
    "\n",
    "%matplotlib widget\n",
    "\n",
    "# ---- Original VK-74 list: [Y, X, Z] ----\n",
    "Vant_yxz = np.array([\n",
    "  [-0.0275,-0.0267,0],[-0.0253,-0.0267,0],[-0.0231,-0.0267,0],[-0.0209,-0.0267,0],\n",
    "  [-0.0187,-0.0267,0],[-0.0165,-0.0267,0],[-0.0143,-0.0267,0],[-0.0122,-0.0267,0],\n",
    "  [-0.01,-0.0267,0],[-0.0078,-0.0267,0],[-0.0056,-0.0267,0],[-0.0034,-0.0267,0],\n",
    "  [-0.0012,-0.0267,0],[0.0009,-0.0267,0],[0.0031,-0.0267,0],[0.0053,-0.0267,0],\n",
    "  [0.0075,-0.0267,0],[0.0097,-0.0267,0],[0.0119,-0.0267,0],[0.0141,-0.0267,0],\n",
    "  [0.0274,-0.0133,0],[0.0274,-0.0112,0],[0.0274,-0.0091,0],[0.0274,-0.007,0],\n",
    "  [0.0274,-0.0049,0],[0.0274,-0.0028,0],[0.0274,-0.0007,0],[0.0275,0.0014,0],\n",
    "  [0.0275,0.0035,0],[0.0275,0.0056,0],[0.0275,0.0078,0],[0.0275,0.0099,0],\n",
    "  [0.0275,0.012,0],[0.0274,0.0141,0],[0.0274,0.0162,0],[0.0275,0.0183,0],\n",
    "  [0.0275,0.0204,0],[0.0275,0.0225,0],[0.0275,0.0246,0],[0.0275,0.0267,0]\n",
    "], dtype=np.float32)\n",
    "\n",
    "# Convert to (x=vertical, y=horizontal, z=downrange)\n",
    "Vant_xyz = Vant_yxz[:, [1, 0, 2]]\n",
    "\n",
    "# Split by hardware: RX first 20, TX last 20\n",
    "RX_hw = Vant_xyz[:20]\n",
    "TX_hw = Vant_xyz[20:]\n",
    "\n",
    "# =========================\n",
    "# TX & RX ANTENNA POSITIONS\n",
    "# =========================\n",
    "gap = 0.0133\n",
    "margin = 0.003  # keep small separation from zero axes\n",
    "\n",
    "# --- TX x-spacing preserved ---\n",
    "tx_x_raw  = TX_hw[:, 0]\n",
    "tx_order  = np.argsort(tx_x_raw)[::-1]            # TX1(top) → TX20(bottom)\n",
    "tx_sorted = tx_x_raw[tx_order]\n",
    "tx_span   = tx_sorted.max() - tx_sorted.min()\n",
    "\n",
    "# --- RX y-spacing preserved ---\n",
    "rx_y_raw  = RX_hw[:, 1]\n",
    "rx_order  = np.argsort(rx_y_raw)                  # RX21(left) → RX40(right)\n",
    "rx_y_sorted = rx_y_raw[rx_order]\n",
    "\n",
    "# Set RX x-position so TX20.x = RX21.x + gap\n",
    "RX_x_val = 0.0  # start RX at zero for now\n",
    "TX_x = (tx_sorted - tx_sorted.min()) + (RX_x_val + gap)\n",
    "\n",
    "# Set RX y base so TX_y = RX21_y - gap\n",
    "RX_y = rx_y_sorted - rx_y_sorted.min()  # preserve spacing from RX21\n",
    "TX_y_val = RX_y.min() - gap\n",
    "\n",
    "# If any coordinates are negative, shift everything up/right together\n",
    "shift_x = 0\n",
    "shift_y = 0\n",
    "\n",
    "if TX_x.min() < 0 or RX_x_val < 0:\n",
    "    shift_x = abs(min(TX_x.min(), RX_x_val)) + margin\n",
    "if TX_y_val < 0 or RX_y.min() < 0:\n",
    "    shift_y = abs(min(TX_y_val, RX_y.min())) + margin\n",
    "\n",
    "TX_x += shift_x\n",
    "RX_x_val += shift_x\n",
    "RX_y += shift_y\n",
    "TX_y_val += shift_y\n",
    "\n",
    "# Build RX positions\n",
    "RX_x = np.full_like(RX_y, RX_x_val)\n",
    "TX_z = np.zeros_like(TX_x)\n",
    "RX_z = np.zeros_like(RX_y)\n",
    "\n",
    "TX_plot = np.column_stack([TX_x, np.full_like(TX_x, TX_y_val), TX_z])\n",
    "RX_plot = np.column_stack([RX_x, RX_y, RX_z])\n",
    "tx_labels = [f\"{i}\" for i in range(1, 21)]\n",
    "rx_labels = [f\"{i}\" for i in range(21, 41)]\n",
    "\n",
    "# -----------------\n",
    "# Plotting antennas\n",
    "# -----------------\n",
    "def to_plot(arr_xyz):\n",
    "    return np.column_stack([arr_xyz[:,1], arr_xyz[:,0], arr_xyz[:,2]])\n",
    "\n",
    "TXp = to_plot(TX_plot)\n",
    "RXp = to_plot(RX_plot)\n",
    "\n",
    "fig = plt.figure(figsize=(7,5))\n",
    "ax = fig.add_subplot(projection=\"3d\")\n",
    "ax.set_box_aspect((1, 1, 0.05))\n",
    "\n",
    "ax.scatter(TXp[:,0], TXp[:,1], TXp[:,2], s=110, c=\"red\",  edgecolors=\"black\", label=\"TX 1–20\")\n",
    "ax.scatter(RXp[:,0], RXp[:,1], RXp[:,2], s=110, c=\"blue\", edgecolors=\"black\", label=\"RX 21–40\")\n",
    "\n",
    "stroke = [pe.withStroke(linewidth=3.5, foreground=\"white\")]\n",
    "for (xp, yp, zp), lab in zip(TXp, tx_labels):\n",
    "    ax.text(xp, yp, zp, lab, fontsize=12, color=\"red\", path_effects=stroke, ha='center', va='center')\n",
    "for (xp, yp, zp), lab in zip(RXp, rx_labels):\n",
    "    ax.text(xp, yp, zp, lab, fontsize=12, color=\"blue\", path_effects=stroke, ha='center', va='center')\n",
    "\n",
    "ax.set_xlabel(\"y (horizontal)\")\n",
    "ax.set_ylabel(\"x (vertical)\")\n",
    "ax.set_zlabel(\"z (downrange)\")\n",
    "ax.view_init(elev=12, azim=25)\n",
    "ax.legend(loc=\"upper left\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ------------------------\n",
    "# Print antenna coordinates\n",
    "# ------------------------\n",
    "def print_antenna_coordinates():\n",
    "    print(\"\\n=== TX Antennas (1–20) ===\")\n",
    "    for label, coords in zip(tx_labels, TX_plot):\n",
    "        x, y, z = coords\n",
    "        print(f\"TX{label:>2}: x={x:.4f} m, y={y:.4f} m, z={z:.4f} m\")\n",
    "\n",
    "    print(\"\\n=== RX Antennas (21–40) ===\")\n",
    "    for label, coords in zip(rx_labels, RX_plot):\n",
    "        x, y, z = coords\n",
    "        print(f\"RX{label:>2}: x={x:.4f} m, y={y:.4f} m, z={z:.4f} m\")\n",
    "\n",
    "print_antenna_coordinates()\n",
    "\n",
    "# ------------------------\n",
    "# Sanity check constraints\n",
    "# ------------------------\n",
    "tx20_x = TX_x.min()\n",
    "rx21_x = RX_x_val\n",
    "rx21_y = RX_y.min()\n",
    "tx_y   = TX_y_val\n",
    "\n",
    "print(f\"\\nCheck X-gap: TX20.x - RX21.x = {tx20_x - rx21_x:.4f} m (target {gap})\")\n",
    "print(f\"Check Y-gap: RX21.y - TX.y   = {rx21_y - tx_y:.4f} m (target {gap})\")\n",
    "print(f\"Min X = {min(TX_x.min(), RX_x_val):.4f}, Min Y = {min(TX_y_val, RX_y.min()):.4f}\")\n"
   ]
  },
