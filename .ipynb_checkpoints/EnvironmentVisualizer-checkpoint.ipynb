    "# visualize_voxels_and_scan.py\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "# Optional: SciPy only needed if loading the .mat file\n",
    "try:\n",
    "    from scipy.io import loadmat\n",
    "    SCIPY_OK = True\n",
    "except Exception:\n",
    "    SCIPY_OK = False\n",
    "\n",
    "# ====================\n",
    "# ===== USER INPUTS ===\n",
    "# ====================\n",
    "nx, ny, nz = 2, 1500, 1500                     # number of voxels along x, y, z\n",
    "x_bounds = (0.00, 0.70)                     # meters (vertical range)\n",
    "y_bounds = (0.00, 0.60)                     # meters (horizontal range)\n",
    "z_bounds = (0.40, 0.60)                     # meters (downrange)\n",
    "\n",
    "# =========================\n",
    "# === FIXED SCAN SETTINGS =\n",
    "# =========================\n",
    "N = 5                                       # 5x5 scan\n",
    "STEP_M = 0.040                              # 40 mm step\n",
    "START_XY = (0.0, 0.0)                       # lower-left origin (x=vertical, y=horizontal)\n",
    "MAT_FILE = \"AntennaLocations.mat\"           # produced by your Python exporter\n",
    "\n",
    "\n",
    "def load_antennas(mat_file=MAT_FILE):\n",
    "    \"\"\"\n",
    "    Loads antenna locations. Expects:\n",
    "      TX_x (20,), TX_y (20,), RX_x (20,), RX_y (20,)\n",
    "    Returns dict with:\n",
    "      TX_line: (2,3) endpoints for TX segment (constant y)\n",
    "      RX_line: (2,3) endpoints for RX segment (constant x)\n",
    "    \"\"\"\n",
    "    # Fall back if user already has arrays in session (advanced use)\n",
    "    global TX_x, TX_y, RX_x, RX_y  # noqa: F401 (optional)\n",
    "    if 'TX_x' in globals() and 'TX_y' in globals() and 'RX_x' in globals() and 'RX_y' in globals():\n",
    "        TXx, TXy, RXx, RXy = np.asarray(TX_x), np.asarray(TX_y), np.asarray(RX_x), np.asarray(RX_y)\n",
    "    else:\n",
    "        if not SCIPY_OK:\n",
    "            raise RuntimeError(\"scipy is required to load AntennaLocations.mat (pip install scipy).\")\n",
    "        if not Path(mat_file).exists():\n",
    "            raise FileNotFoundError(f\"'{mat_file}' not found. Put it next to this script or adjust MAT_FILE.\")\n",
    "        S = loadmat(mat_file)\n",
    "        TXx = np.ravel(S['TX_x']).astype(float)  # shape (20,)\n",
    "        TXy = np.ravel(S['TX_y']).astype(float)  # shape (20,), constant value\n",
    "        RXx = np.ravel(S['RX_x']).astype(float)  # shape (20,), constant value\n",
    "        RXy = np.ravel(S['RX_y']).astype(float)  # shape (20,)\n",
    "\n",
    "    # Build line segments (two endpoints each) — z=0 plane\n",
    "    TX_line = np.array([\n",
    "        [TXx.min(), TXy[0], 0.0],\n",
    "        [TXx.max(), TXy[0], 0.0]\n",
    "    ])\n",
    "    RX_line = np.array([\n",
    "        [RXx[0], RXy.min(), 0.0],\n",
    "        [RXx[0], RXy.max(), 0.0]\n",
    "    ])\n",
    "    return {\"TX_line\": TX_line, \"RX_line\": RX_line, \"TXx\": TXx, \"TXy\": TXy, \"RXx\": RXx, \"RXy\": RXy}\n",
    "\n",
    "\n",
    "def make_snake_positions(N=5, step=0.04, start_xy=(0.0, 0.0)):\n",
    "    \"\"\"\n",
    "    Creates a 5x5 snake scan in x (vertical) and y (horizontal).\n",
    "    Pattern (indices): \n",
    "      row2: 10  9  8  7  6\n",
    "      row1:  1  2  3  4  5\n",
    "      ...\n",
    "      to 25\n",
    "    Returns:\n",
    "      positions: (N*N, 2) array of [x, y] in meters, in visit order 1..25\n",
    "      order_map: (N, N) integer map of visit order for debugging/overlay\n",
    "    \"\"\"\n",
    "    x0, y0 = start_xy\n",
    "    xs = x0 + np.arange(N) * step               # vertical rows (x)\n",
    "    ys = y0 + np.arange(N) * step               # horizontal cols (y)\n",
    "\n",
    "    order_map = np.zeros((N, N), dtype=int)\n",
    "    positions = []\n",
    "\n",
    "    idx = 1\n",
    "    for r in range(N):\n",
    "        # snake across columns\n",
    "        cols = range(N) if (r % 2 == 0) else range(N-1, -1, -1)\n",
    "        for c in cols:\n",
    "            order_map[r, c] = idx\n",
    "            positions.append([xs[r], ys[c]])\n",
    "            idx += 1\n",
    "\n",
    "    return np.array(positions, dtype=float), order_map\n",
    "\n",
    "\n",
    "def draw_voxel_bounds(ax, xb, yb, zb, alpha=0.08, lw=1.2):\n",
    "    \"\"\"\n",
    "    Draws a translucent bounding box for the voxel volume.\n",
    "    \"\"\"\n",
    "    x0, x1 = xb\n",
    "    y0, y1 = yb\n",
    "    z0, z1 = zb\n",
    "\n",
    "    # 12 edges of the box\n",
    "    edges = [\n",
    "        # bottom rectangle (z=z0)\n",
    "        ([x0, x1], [y0, y0], [z0, z0]),\n",
    "        ([x0, x1], [y1, y1], [z0, z0]),\n",
    "        ([x0, x0], [y0, y1], [z0, z0]),\n",
    "        ([x1, x1], [y0, y1], [z0, z0]),\n",
    "        # top rectangle (z=z1)\n",
    "        ([x0, x1], [y0, y0], [z1, z1]),\n",
    "        ([x0, x1], [y1, y1], [z1, z1]),\n",
    "        ([x0, x0], [y0, y1], [z1, z1]),\n",
    "        ([x1, x1], [y0, y1], [z1, z1]),\n",
    "        # vertical pillars\n",
    "        ([x0, x0], [y0, y0], [z0, z1]),\n",
    "        ([x0, x0], [y1, y1], [z0, z1]),\n",
    "        ([x1, x1], [y0, y0], [z0, z1]),\n",
    "        ([x1, x1], [y1, y1], [z0, z1]),\n",
    "    ]\n",
    "    for X, Y, Z in edges:\n",
    "        ax.plot(X, Y, Z, linewidth=lw, alpha=0.9)\n",
    "\n",
    "    # lightly fill the six faces corners (as markers) to hint volume\n",
    "    corners = np.array([[x0, y0, z0], [x0, y0, z1], [x0, y1, z0], [x0, y1, z1],\n",
    "                        [x1, y0, z0], [x1, y0, z1], [x1, y1, z0], [x1, y1, z1]])\n",
    "    ax.scatter(corners[:,1], corners[:,0], corners[:,2], s=15, alpha=0.6)  # plotX=y, plotY=x\n",
    "\n",
    "\n",
    "def plot_scene(nx, ny, nz, x_bounds, y_bounds, z_bounds):\n",
    "    # Load antennas (as lines)\n",
    "    ants = load_antennas()\n",
    "    TX_line, RX_line = ants[\"TX_line\"], ants[\"RX_line\"]\n",
    "\n",
    "    # Build snake scan\n",
    "    positions, order_map = make_snake_positions(N=N, step=STEP_M, start_xy=START_XY)\n",
    "\n",
    "    # Figure/axes\n",
    "    fig = plt.figure(figsize=(9, 6))\n",
    "    ax = fig.add_subplot(projection=\"3d\")\n",
    "\n",
    "    # Plot voxel bounding box (translucent edges)\n",
    "    draw_voxel_bounds(ax, x_bounds, y_bounds, z_bounds, alpha=0.08)\n",
    "\n",
    "    # Plot TX/RX as lines (remember: screen X=y, screen Y=x for your view)\n",
    "    ax.plot(TX_line[:,1], TX_line[:,0], TX_line[:,2], linewidth=4, label=\"TX array\")\n",
    "    ax.plot(RX_line[:,1], RX_line[:,0], RX_line[:,2], linewidth=4, label=\"RX array\")\n",
    "\n",
    "    # Plot snake path through positions (x vertical, y horizontal)\n",
    "    # Draw path as a connected polyline at z = z_bounds[0] (near field plane)\n",
    "    z_plane = np.full(len(positions), z_bounds[0])\n",
    "    ax.plot(positions[:,1], positions[:,0], z_plane, linewidth=2, alpha=0.9, label=\"Scan path\")\n",
    "\n",
    "    # Label only a few waypoints to avoid clutter (1,5,10,15,20,25)\n",
    "    label_ids = {1,5,10,15,20,25}\n",
    "    for i, (xv, yv) in enumerate(positions, start=1):\n",
    "        if i in label_ids:\n",
    "            ax.text(yv, xv, z_bounds[0], f\"{i}\", fontsize=10, ha='center', va='bottom')\n",
    "\n",
    "    # Axes labels (your convention)\n",
    "    ax.set_xlabel(\"y (horizontal)\")\n",
    "    ax.set_ylabel(\"x (vertical)\")\n",
    "    ax.set_zlabel(\"z (downrange)\")\n",
    "\n",
    "    # Set limits to show everything comfortably\n",
    "    x0, x1 = x_bounds\n",
    "    y0, y1 = y_bounds\n",
    "    z0, z1 = z_bounds\n",
    "    ax.set_xlim(y0, y1)\n",
    "    ax.set_ylim(x0, x1)\n",
    "    ax.set_zlim(z0, z1)\n",
    "\n",
    "    # Equal-ish aspect\n",
    "    ax.set_box_aspect((y1 - y0, x1 - x0, z1 - z0))\n",
    "    ax.view_init(elev=18, azim=35)\n",
    "    ax.legend(loc=\"upper left\")\n",
    "    ax.set_title(f\"Voxel Volume ({nx}×{ny}×{nz}) and 5×5 Snake Scan (40 mm steps)\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # (Optional) return objects if you want to reuse them\n",
    "    return {\"positions\": positions, \"order_map\": order_map, **ants}\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    _ = plot_scene(nx, ny, nz, x_bounds, y_bounds, z_bounds)\n"
   ]
