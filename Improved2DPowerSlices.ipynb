    "#batch normalize in groups of 5\n",
    "\n",
    "# y_accum: (Ny, Nx, N), complex\n",
    "eps = 1e-12\n",
    "Ny, Nx, N = y_accum.shape\n",
    "\n",
    "# group into chunks of 5\n",
    "groups = [slice(i, min(i+5, N)) for i in range(0, N, 5)]\n",
    "\n",
    "# coherent sum within each group (complex sum), then non-coherent across groups (magnitude sum)\n",
    "group_coh = [y_accum[:, :, sl].sum(axis=2) for sl in groups]     # list of (Ny, Nx) complex\n",
    "improved  = np.sum([np.abs(g) for g in group_coh], axis=0)       # (Ny, Nx) magnitude\n",
    "\n",
    "# normalize final image to 0 dB (global max → 0 dB)\n",
    "ref = improved.max()\n",
    "improved_db = 20*np.log10(improved/(ref + eps) + eps)\n",
    "\n",
    "# optional: plot\n",
    "ymin, ymax = float(Ygrid.min()), float(Ygrid.max())\n",
    "zmin, zmax = float(Zgrid.min()), float(Zgrid.max())\n",
    "vmin, vmax = np.percentile(improved_db, [20, 99])\n",
    "\n",
    "plt.figure(figsize=(6,5))\n",
    "plt.imshow(improved_db, extent=[ymin, ymax, zmin, zmax], origin='lower',\n",
    "           aspect='auto', vmin=vmin, vmax=vmax)\n",
    "plt.title(\"Improved image (5-scan groups)\")\n",
    "plt.xlabel(\"Y [m]\"); plt.ylabel(\"Z [m]\")\n",
    "plt.colorbar(label=\"dB\")\n",
    "plt.show()"
   ]
